includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/
        - config/
        - database/
        - routes/
    tmpDir: storage/framework/cache/phpstan
    # Read model casts from the casts() method, so enum, date and array casts are typed.
    parseModelCastsMethod: true
