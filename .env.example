APP_NAME="Gede Maitree Club"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_TIMEZONE=Asia/Kolkata

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gede_maitree
DB_USERNAME=gmc
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sample sign-ins created by the seeder (leave blank to have the seeder generate and print them once)
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=
SEED_MEMBER_EMAIL=member@example.org
SEED_MEMBER_PASSWORD=

# One-time code driver for sign-in by phone: "log" writes codes to the log (no SMS provider yet)
OTP_DRIVER=log

# Online payments (Razorpay Standard Checkout). Get the keys from the Razorpay Dashboard:
# Account & Settings → API Keys (Test mode keys start rzp_test_, live keys rzp_live_).
# Leave the key ID or secret blank to use "UPI to the club" instead (member enters the UTR,
# the treasurer confirms). Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when adding the webhook https://<your-domain>/webhooks/razorpay
# (events: payment.captured, payment.failed, order.paid).
RAZORPAY_WEBHOOK_SECRET=

# UPI to the club (used when Razorpay keys are blank): UPI ID and payee name for the QR code.
# Blank means the UPI ID saved in Console → Club settings.
CLUB_UPI_ID=
CLUB_UPI_NAME="Gede Maitree Club"
